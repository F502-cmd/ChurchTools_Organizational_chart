# Umgebungs- & Geheimnis-Dateien (aus allen Ordnern ignorieren)
.env*
*.env

# Python Cache & virtuelle Umgebungen
__pycache__/
*.pyc
.venv/
venv/
env/
/.env
build/
dist/
*.egg-info/

# IDE & Editor-Einstellungen
.vscode/
.idea/

# Betriebssystem-Dateien
.DS_Store
Thumbs.db

